#!/bin/sh
# Rich pre-commit hook: static skin checks on the staged files.
# Enable once per clone:   git config core.hooksPath .githooks
# Skip in an emergency:    git commit --no-verify

if ! command -v pwsh >/dev/null 2>&1; then
    echo "pre-commit: pwsh (PowerShell 7) not found, skin checks skipped." >&2
    exit 0
fi

exec pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass \
    -File "$(git rev-parse --show-toplevel)/script/test-skin.ps1" -Staged
